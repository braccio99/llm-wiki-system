# ─────────────────────────────────────────────────────────
# LLM Wiki — environment variables
# Copy to .env and fill in what you need for your provider.
# ─────────────────────────────────────────────────────────

# ── Anthropic (provider: "anthropic") ────────────────────
# ANTHROPIC_API_KEY=sk-ant-...

# ── OpenAI (provider: "openai") ──────────────────────────
# OPENAI_API_KEY=sk-...

# ── Generic / any other provider ─────────────────────────
# LLM_API_KEY=your_key_here
# LLM_BASE_URL=https://api.example.com/v1

# ── Local providers — no key needed ──────────────────────
# Ollama:    set provider: "ollama"    in config.yaml (auto → http://localhost:11434/v1)
# LM Studio: set provider: "lmstudio" in config.yaml (auto → http://localhost:1234/v1)
# vLLM:      set provider: "vllm"     in config.yaml (auto → http://localhost:8000/v1)

# ── Optional overrides ────────────────────────────────────
# LLM_MODEL=claude-opus-4-7       # overrides config.yaml llm.model
# LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
